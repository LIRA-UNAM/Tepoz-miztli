<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_cam_down'>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>
    <include>
      <uri>model://mono_cam</uri>
      <pose>0 0 .10 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name='CameraJoint' type='fixed'>
      <parent>base_link</parent>
      <child>mono_cam::link</child>
    </joint>
    <link name="vio_imu_link">
      <pose>0 0 0 0 0 0</pose> <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.00001</iyy> <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      
      <sensor name="vio_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate> <visualize>true</visualize>
        <topic>imu/data</topic>
      </sensor>
    </link>

    <joint name="vio_imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>vio_imu_link</child>
    </joint>
  </model>
</sdf>